{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023", "dom"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    // Source imports carry the real `.ts` path, as Node's own type stripping requires;
    // tsc rewrites them to `.js` on emit so one spelling serves both.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // Diopsis loads TypeScript config files through Node's strip-only type stripping, which
    // erases types but generates no code — so enums, namespaces and parameter properties do
    // not survive it. Failing at compile time is how that stays true of our own source.
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
