{
  // The preview stylesheet MUST be workspace-relative: VS Code resolves markdown.styles
  // against the folder open in the Explorer and will not reliably load an absolute local
  // path, so a user-settings copy does nothing. This file is a verbatim copy of the
  // machine-local source. Removing it silently breaks the preview.
  "markdown.styles": [".vscode/markdown-preview.css"],

  // Code blocks scroll rather than wrap (see the stylesheet) — wrapping breaks the ASCII
  // diagrams in DECISIONS.md and misrepresents indentation.
  "markdown.validate.referenceLinks.enabled": "ignore",
  "markdown.validate.fileLinks.enabled": "warning",
  "markdown.validate.fragmentLinks.enabled": "warning",

  // Prettier does not govern this repo's markdown, but the user-level settings set
  // editor.formatOnSave globally with Prettier as the [markdown] formatter, so it would
  // rewrite these files on save using settings nothing here checks.
  "[markdown]": { "editor.formatOnSave": false }
}
